#!/bin/bash
# theme picker with image previews + keyboard color sync (asusctl)
source "$(dirname "$0")/thumbcache"

themes_dir="$HOME/.config/odyssey/themes"
odyssey="$HOME/.config/odyssey/bin/odyssey"
current_theme=$(cat ~/.config/odyssey/.current-theme 2>/dev/null || echo "dynamic")

# calculate optimal columns based on screen width
if command -v hyprctl &>/dev/null; then
    mon_width=$(hyprctl monitors -j | jq '.[0].width // 1920')
elif command -v xrandr &>/dev/null; then
    mon_width=$(xrandr | grep '\*' | head -1 | awk '{print $1}' | cut -d'x' -f1)
else
    mon_width=1920
fi

# ~200px per theme card at 80% width, cap between 3-6 columns
cols=$(( (mon_width * 80 / 100) / 200 ))
[[ $cols -lt 3 ]] && cols=3
[[ $cols -gt 6 ]] && cols=6

# get preview image: preview.png > backgrounds/* > wallpaper symlink
get_preview() {
	local dir="$1"
	[[ -f "$dir/preview.png" ]] && echo "$dir/preview.png" && return
	[[ -f "$dir/preview.jpg" ]] && echo "$dir/preview.jpg" && return

	local wall
	wall=$(find "$dir/backgrounds" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | sort -V | head -1)
	[[ -n "$wall" ]] && echo "$wall" && return

	[[ -L "$dir/wallpaper" ]] && readlink -f "$dir/wallpaper"
}

menu() {
	for dir in "$themes_dir"/*/; do
		name=$(basename "$dir")
		[[ "$name" == "Wallpapers" || "$name" == ".git" ]] && continue
		[[ ! -d "$dir/.config" ]] && continue

		preview=$(get_preview "$dir")
		[[ -z "$preview" ]] && continue

		printf "%s\x00icon\x1f%s\n" "$name" "$(get_thumb "$preview")"
	done | sort
}

# -----------------------------
# Keyboard color sync (asusctl)
# -----------------------------

# Extract the first hex color (#rrggbb or #rgb) from a file
first_hex_in_file() {
	local f="$1"
	[[ -f "$f" ]] || return 1
	grep -oE '#[0-9a-fA-F]{6}\b|#[0-9a-fA-F]{3}\b' "$f" 2>/dev/null | head -n1
}

# Convert theme hex like "#aabbcc" or "#abc" into asusctl format "aabbcc"
normalize_asusctl_color() {
	local c="$1"

	# remove leading '#'
	c="${c#\#}"

	# expand 3-digit hex (abc -> aabbcc)
	if [[ "$c" =~ ^[0-9a-fA-F]{3}$ ]]; then
		c="${c:0:1}${c:0:1}${c:1:1}${c:1:1}${c:2:1}${c:2:1}"
	fi

	# validate
	[[ "$c" =~ ^[0-9a-fA-F]{6}$ ]] || return 1
	echo "$c"
}

# Determine "main_color" for a given theme name (best-effort)
get_main_color_for_theme() {
	local theme="$1"
	local tdir="$themes_dir/$theme"
	local c=""

	# 1) Prefer pywal cache if present
	#    - colors.sh defines $color0..$color15
	if [[ -f "$HOME/.cache/wal/colors.sh" ]]; then
		# shellcheck disable=SC1090
		source "$HOME/.cache/wal/colors.sh" 2>/dev/null || true
		[[ -n "${color1:-}" ]] && { echo "$color1"; return 0; }
		[[ -n "${color4:-}" ]] && { echo "$color4"; return 0; }
	fi

	# 2) Try theme-local likely files (adjust/add if needed)
	for f in \
		"$tdir/colors.sh" \
		"$tdir/colors.css" \
		"$tdir/colors.json" \
		"$tdir/.config/rofi/colors.rasi" \
		"$tdir/.config/gtk-3.0/gtk.css" \
		"$tdir/.config/waybar/style.css" \
		"$tdir/.config/kitty/kitty.conf" \
		"$tdir/.config/alacritty/alacritty.yml" \
		"$tdir/.config/alacritty/alacritty.yaml" \
		"$tdir/.config/alacritty/alacritty.toml"
	do
		c=$(first_hex_in_file "$f" || true)
		[[ -n "$c" ]] && { echo "$c"; return 0; }
	done

	# 3) Last resort: odyssey generic guesses
	for f in \
		"$HOME/.config/odyssey/colors.sh" \
		"$HOME/.config/odyssey/colors.css" \
		"$HOME/.config/odyssey/colors.rasi" \
		"$HOME/.cache/odyssey/colors.sh"
	do
		c=$(first_hex_in_file "$f" || true)
		[[ -n "$c" ]] && { echo "$c"; return 0; }
	done

	return 1
}

apply_keyboard_color() {
	local theme="$1"

	command -v asusctl &>/dev/null || return 0

	local main_color asus_color
	main_color="$(get_main_color_for_theme "$theme" || true)"
	asus_color="$(normalize_asusctl_color "$main_color" || true)"

	if [[ -z "$main_color" || -z "$asus_color" ]]; then
		notify-send "Keyboard color" "Couldn't detect a valid main color for '$theme' (skipping)"
		return 0
	fi

	# IMPORTANT: your asusctl expects color WITHOUT '#'
	local out code
	out="$(asusctl aura effect static -c "$asus_color" 2>&1)"
	code=$?
}

# -----------------------------
# Main flow
# -----------------------------

choice=$(menu | rofi -i -dmenu -p "" \
	-theme-str "listview{columns:$cols;}" \
	-config ~/.config/rofi/custom-rofi/config-theme-picker.rasi)

[[ -z "$choice" ]] && exit 0

if [[ "$choice" == "$current_theme" ]]; then
	notify-send "Already using $choice"
	exit 0
fi

"$odyssey" switch "$choice"

# sync keyboard color after theme switch
apply_keyboard_color "$choice"
