md_version() {
	echo "Odyssey v$VERSION"
}

# ╭───────────────────────────────────────────────────────────────────────╮
# │ Main                                                                  │
# ╰───────────────────────────────────────────────────────────────────────╯

case "${1:-help}" in
	switch)          shift; cmd_switch "$@" ;;
	reload)          cmd_reload ;;
	fix)             cmd_fix ;;
	list|ls)         cmd_list ;;
	current) echo ""; echo -e "  ${GREEN}●${RESET} $(current_theme)";;
	remove|rm)       shift; cmd_remove "$@" ;;
	doctor)          cmd_doctor ;;
	help|-h|--help)  cmd_help ;;
	version|-v)      cmd_version ;;
	*)               err "Unknown: $1"; echo "Try: odyssey help"; exit 1 ;;
esac
