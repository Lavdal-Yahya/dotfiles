set -e

ODYSSEY_DIR="$HOME/.config/odyssey"
THEMES_DIR="$ODYSSEY_DIR/themes"
HOOKS_DIR="$ODYSSEY_DIR/hooks"
CURRENT_LINK="$ODYSSEY_DIR/current"
THEME_FILE="$ODYSSEY_DIR/.current-theme"
LOG_FILE="$ODYSSEY_DIR/log/hooks.log"


VERSION="2.0.0"

# colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
RESET='\033[0m'

ok()   { echo -e "${GREEN}[OK]${RESET} $1" >&2; }
err()  { echo -e "${RED}[ERROR]${RESET} $1" >&2; }
info() { echo -e "${BLUE}[INFO]${RESET} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${RESET} $1" >&2; }


notify() {
	command -v notify-send &>/dev/null && notify-send "$1" "$2" ${3:+-i "$3"}
}

current_theme() {
	cat "$THEME_FILE" 2>/dev/null || echo "dynamic"
}

theme_exists() {
	[[ -d "$THEMES_DIR/$1" ]]
}

list_themes() {
	echo "dynamic"
	for dir in "$THEMES_DIR"/*/; do
		name=$(basename "$dir")
		[[ "$name" != "dynamic" && "$name" != "Wallpapers" ]] && echo "$name"
	done | sort
}

run_hooks() {
  mkdir -p "$(dirname "$LOG_FILE")"
  : > "$LOG_FILE"

  echo "Running hooks..." | tee -a "$LOG_FILE"
  for hook in "$HOOKS_DIR"/*.sh; do
    [[ -e "$hook" ]] || continue
    [[ -x "$hook" ]] || chmod +x "$hook"
    name=$(basename "$hook" .sh)

    if CURRENT_LINK="$CURRENT_LINK" THEMES_DIR="$THEMES_DIR" bash "$hook" >>"$LOG_FILE" 2>&1; then
      echo "  ✓ ${name#*-}" | tee -a "$LOG_FILE"
    else
      echo "  ✗ ${name#*-} (failed)" | tee -a "$LOG_FILE"
    fi
  done
}



set_wallpaper() {
	local theme="$1"
	
	# Dynamic theme uses ~/Wallpapers with matugen
	if [[ "$theme" == "dynamic" ]]; then
		"$HOME/.config/hypr/scripts/change-theme"
		return
	fi
	
	local wall
	wall=$(find "$THEMES_DIR/$theme/backgrounds" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | sort -V | head -1)
	[[ -z "$wall" ]] && return

	swww query &>/dev/null || {
		swww-daemon --format xrgb &
		sleep 0.3
	}
	swww img "$wall" --transition-type center --transition-fps 120 --transition-duration 0.8
	ln -sfn "backgrounds/$(basename "$wall")" "$THEMES_DIR/$theme/wallpaper"
}

# ╭───────────────────────────────────────────────────────────────────────╮
# │ Commands                                                              │
# ╰───────────────────────────────────────────────────────────────────────╯

get_random_theme() {
	local themes=()
	mapfile -t themes < <(list_themes)
	[[ ${#themes[@]} -eq 0 ]] && { err "No themes found"; exit 1; }
	
	local current=$(current_theme)
	local theme="${themes[RANDOM % ${#themes[@]}]}"
	
	# Avoid current theme if possible
	if [[ ${#themes[@]} -gt 1 ]]; then
		for _ in {1..10}; do
			[[ "$theme" != "$current" ]] && break
			theme="${themes[RANDOM % ${#themes[@]}]}"
		done
	fi
	echo "$theme"
}

cmd_switch() {
	local theme="$1"
    [[ "$theme" == "--random" ]] && theme=$(get_random_theme)

	if [[ -z "$theme" ]]; then
		command -v rofi &>/dev/null || { err "rofi is required"; exit 1; }
		local theme_picker="$HOME/.config/rofi/scripts/themePicker"
		if [[ -x "$theme_picker" ]]; then
			exec "$theme_picker"
		else
			theme=$(list_themes | rofi -dmenu -i -p "Theme" -config "$HOME/.config/rofi/config.rasi") || exit 0
		fi
	fi

	[[ -z "$theme" ]] && exit 0
	[[ "$theme" == "$(current_theme)" ]] && {
		notify "Already using $theme"
		exit 0
	}
	theme_exists "$theme" || {
		err "Theme not found: $theme"
		exit 1
	}

	info "Switching to $theme..."
	notify "Odyssey" "Switching to $theme..."
	hyprctl keyword misc:disable_autoreload 1 &>/dev/null || true

	mkdir -p "$ODYSSEY_DIR" "$(dirname "$LOG_FILE")"
	echo "$theme" > "$THEME_FILE"
	ln -sfn "$THEMES_DIR/$theme" "$CURRENT_LINK"

	# Dynamic theme runs hooks via change-theme -> odyssey reload
	if [[ "$theme" != "dynamic" ]]; then
		run_hooks
	fi

	hyprctl keyword misc:disable_autoreload 0 &>/dev/null || true
	hyprctl reload || true
	set_wallpaper "$theme"

	# Dynamic theme handles its own notification via change-theme script
	if [[ "$theme" != "dynamic" ]]; then
		notify "$theme" "" "$(readlink -f "$THEMES_DIR/$theme/wallpaper" 2>/dev/null)"
	fi
	ok "Switched to $theme"
}

cmd_reload() {
	local theme
	theme=$(current_theme)
	info "Reloading $theme..."

	mkdir -p "$ODYSSEY_DIR" "$(dirname "$LOG_FILE")"
	ln -sfn "$THEMES_DIR/$theme" "$CURRENT_LINK"

	hyprctl keyword misc:disable_autoreload 1 &>/dev/null || true
	run_hooks
	hyprctl keyword misc:disable_autoreload 0 &>/dev/null || true
	hyprctl reload || true

	ok "Reloaded $theme"
}

cmd_list() {
	local current
	current=$(current_theme)
	echo ""
	for theme in $(list_themes); do
		if [[ "$theme" == "$current" ]]; then
			echo -e "  ${GREEN}●${RESET} $theme (current)"
		else
			echo "  ○ $theme"
		fi
	done
	echo ""
}

cmd_remove() {
	local theme="$1"
	[[ -z "$theme" ]] && { err "Usage: odyssey remove <theme>"; exit 1; }
	theme_exists "$theme" || { err "Not found: $theme"; exit 1; }
	[[ "$theme" == "dynamic" ]] && { err "Can't remove dynamic theme"; exit 1; }

	printf 'Delete %s? [y/N] ' "$theme"
	read -r confirm
	[[ "$confirm" != "y" ]] && exit 0

	if [[ "$theme" == "$(current_theme)" ]]; then
		local next
		next=$(list_themes | grep -A1 "^$theme$" | tail -1)
		[[ "$next" == "$theme" ]] && next=$(list_themes | head -1)
		cmd_switch "$next"
	fi

	rm -rf "${THEMES_DIR:?}/$theme"
	ok "Removed $theme"
}

cmd_fix() {
	local theme
	theme=$(current_theme)
	info "Fixing symlinks..."
	theme_exists "$theme" || { err "Theme '$theme' not found"; exit 1; }

	mkdir -p "$ODYSSEY_DIR" "$(dirname "$LOG_FILE")"
	ln -sfn "$THEMES_DIR/$theme" "$CURRENT_LINK"
	run_hooks
	hyprctl reload || true
	ok "Fixed $theme"
}



# ╭───────────────────────────────────────────────────────────────────────╮
# │ Doctor                                                                │
# ╰───────────────────────────────────────────────────────────────────────╯

cmd_doctor() {
	local issues=0
	echo ""
	info "Running Odyssey doctor..."
	echo ""

	# Check themes dir
	if [[ -d "$THEMES_DIR" ]]; then
		local count
		count=$(find "$THEMES_DIR" -maxdepth 1 -mindepth 1 -type d | wc -l)
		echo -e "  ${GREEN}✓${RESET} Themes directory exists ($count themes)"
	else
		echo -e "  ${RED}✗${RESET} Themes directory missing: $THEMES_DIR"
		((issues++))
	fi

	# Check hooks dir
	if [[ -d "$HOOKS_DIR" ]]; then
		local hook_count
		hook_count=$(find "$HOOKS_DIR" -name '*.sh' | wc -l)
		echo -e "  ${GREEN}✓${RESET} Hooks directory exists ($hook_count hooks)"
	else
		echo -e "  ${RED}✗${RESET} Hooks directory missing: $HOOKS_DIR"
		((issues++))
	fi

	# Check current theme
	local current
	current=$(current_theme)
	if theme_exists "$current"; then
		echo -e "  ${GREEN}✓${RESET} Current theme '$current' exists"
	else
		echo -e "  ${RED}✗${RESET} Current theme '$current' not found in themes dir"
		((issues++))
	fi

	# Check current symlink
	if [[ -L "$CURRENT_LINK" ]]; then
		local target
		target=$(readlink -f "$CURRENT_LINK")
		if [[ -d "$target" ]]; then
			echo -e "  ${GREEN}✓${RESET} Current symlink resolves → $target"
		else
			echo -e "  ${RED}✗${RESET} Current symlink broken → $target"
			((issues++))
		fi
	else
		echo -e "  ${RED}✗${RESET} Current symlink missing: $CURRENT_LINK"
		((issues++))
	fi

	# Check current theme file content
	if [[ -f "$THEME_FILE" ]]; then
		theme_name=$(cat "$THEME_FILE")
		echo -e "  ${GREEN}✓${RESET} Theme file: $theme_name"
		
		# Check critical theme files if not dynamic
		if [[ "$theme_name" != "dynamic" ]]; then
			# Hyprland
			if [[ -f "$THEMES_DIR/$theme_name/.config/hypr/theme.conf" || -f "$THEMES_DIR/$theme_name/.config/hypr/theme/colors.conf" || -f "$THEMES_DIR/$theme_name/.config/hypr/colors.conf" ]]; then
				echo -e "      ${GREEN}✓${RESET} Hyprland theme config found"
			else
				echo -e "      ${RED}✗${RESET} Hyprland theme config missing (theme.conf or theme/colors.conf)"
				((issues++))
			fi
			
			# Waybar
			if [[ -f "$THEMES_DIR/$theme_name/.config/waybar/colors.css" ]]; then
				echo -e "      ${GREEN}✓${RESET} Waybar colors.css found"
			else
				echo -e "      ${RED}✗${RESET} Waybar colors.css missing"
				((issues++))
			fi
			
			# GTK
			if [[ -f "$THEMES_DIR/$theme_name/.config/gtk-3.0/colors.css" ]]; then
				echo -e "      ${GREEN}✓${RESET} GTK 3.0 colors.css found"
			else
				echo -e "      ${RED}✗${RESET} GTK 3.0 colors.css missing"
				((issues++))
			fi
		fi
	else
		echo -e "  ${YELLOW}⚠${RESET} Theme file missing (will default to 'dynamic')"
	fi

	# Check log dir
	if [[ -d "$(dirname "$LOG_FILE")" ]]; then
		echo -e "  ${GREEN}✓${RESET} Log directory exists"
	else
		echo -e "  ${YELLOW}⚠${RESET} Log directory missing (will be created on next run)"
	fi

	# Check config references
	echo ""
	info "Checking config references..."
	local stale
	stale=$(grep -rl 'symphony/current\|dotfiles/themes' \
		"$HOME/.config/hypr/" \
		"$HOME/.config/waybar/" \
		"$HOME/.config/swaync/" \
		"$HOME/.config/rofi/" \
		2>/dev/null || true)
	if [[ -n "$stale" ]]; then
		echo -e "  ${RED}✗${RESET} Stale symphony/dotfiles references found in:"
		echo "$stale" | while read -r f; do echo "      $f"; done
		((issues++))
	else
		echo -e "  ${GREEN}✓${RESET} No stale symphony/dotfiles references in configs"
	fi

	# Check CLI entrypoint
	if command -v odyssey &>/dev/null; then
		echo -e "  ${GREEN}✓${RESET} 'odyssey' command available in PATH"
	elif [[ -L "$HOME/.local/bin/odyssey" ]]; then
		echo -e "  ${YELLOW}⚠${RESET} ~/.local/bin/odyssey exists but not in PATH"
	else
		echo -e "  ${YELLOW}⚠${RESET} No 'odyssey' command in PATH"
	fi

	echo ""
	if [[ $issues -eq 0 ]]; then
		ok "All checks passed!"
	else
		warn "$issues issue(s) found"
	fi
}

